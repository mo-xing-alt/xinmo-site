# 新模学习 AI 助手 · Caddy 反代配置片段
# 追加到 /etc/caddy/Caddyfile 末尾，然后 sudo systemctl reload caddy
#
# 子域 ai.xinmo.work → 本机回环 127.0.0.1:8792
# 后端只绑 127.0.0.1，公网只走 Caddy 的 443（自动签发 / 续期证书）。

ai.xinmo.work {
    encode gzip

    # SSE 流式必须关闭缓冲，否则思考/回复会被攒成一坨最后才吐出
    reverse_proxy 127.0.0.1:8792 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        flush_interval -1
    }

    log {
        output stderr
        level INFO
    }
}
