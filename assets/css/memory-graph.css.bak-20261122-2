/* ============================================================
 * 私人记忆档案 · 三维图谱视图样式（未来感 / 深空霓虹）
 * 主色基因沿用站点红，辅以冰青与流光金；深空底 + 细线 + 微光。
 * ============================================================ */

/* 图谱入口按钮：霓虹描边 + 微光 */
.pmv-graph-btn {
  color: #7ff3ff;
  border-color: rgba(0, 229, 255, .55);
  background: linear-gradient(180deg, rgba(0, 229, 255, .12), rgba(0, 229, 255, .04));
  box-shadow: 0 0 0 1px rgba(0, 229, 255, .08), 0 0 14px rgba(0, 229, 255, .18);
  letter-spacing: .5px;
  transition: box-shadow .2s ease, color .2s ease;
}
.pmv-graph-btn:hover {
  color: #fff;
  box-shadow: 0 0 0 1px rgba(0, 229, 255, .2), 0 0 22px rgba(0, 229, 255, .38);
}

.mg-view {
  --neon: #00e5ff;
  --neon-soft: rgba(0, 229, 255, .14);
  --hot: #ff2d6f;
  position: relative;
  height: calc(100vh - 62px);
  min-height: 480px;
  margin: 0;
  background:
    radial-gradient(ellipse at 50% 42%, rgba(0, 120, 190, .18) 0%, transparent 55%),
    radial-gradient(ellipse at 82% 88%, rgba(255, 45, 111, .10) 0%, transparent 45%),
    #05070f;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  font-variant-numeric: tabular-nums;
}
.mg-view[hidden] { display: none; }

/* 顶部工具条：细线分隔 + 毛玻璃 */
.mg-toolbar {
  position: relative;
  display: flex; align-items: center; justify-content: space-between; gap: 12px;
  padding: 11px 18px; flex-wrap: wrap;
  background: linear-gradient(180deg, rgba(8, 14, 28, .82), rgba(8, 14, 28, .42));
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-bottom: 1px solid rgba(0, 229, 255, .16);
  z-index: 3;
}
.mg-toolbar::after {
  content: ""; position: absolute; left: 0; right: 0; bottom: -1px; height: 1px;
  background: linear-gradient(90deg, transparent, rgba(0, 229, 255, .5), rgba(255, 45, 111, .4), transparent);
}
.mg-legend { display: flex; flex-wrap: wrap; gap: 7px 15px; }
.mg-legend-item {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: 11.5px; font-weight: 500; letter-spacing: .4px; color: #b9cee8;
}
.mg-legend-item i {
  width: 7px; height: 7px; border-radius: 50%; display: inline-block;
  box-shadow: 0 0 8px currentColor;
}
.mg-actions { display: flex; align-items: center; gap: 8px; }
.mg-hint {
  font-size: 10.5px; letter-spacing: .6px; color: #5f7596;
  padding-right: 6px; border-right: 1px solid rgba(255,255,255,.1);
}
.mg-toolbar .pmv-btn {
  background: rgba(0, 229, 255, .07);
  border: 1px solid rgba(0, 229, 255, .22);
  color: #a8e8f5;
  font-size: 12px; letter-spacing: .4px;
  transition: all .18s ease;
}
.mg-toolbar .pmv-btn:hover {
  background: rgba(0, 229, 255, .16);
  border-color: rgba(0, 229, 255, .5);
  color: #fff;
  box-shadow: 0 0 14px rgba(0, 229, 255, .25);
}

/* 舞台 */
.mg-stage { flex: 1; position: relative; min-height: 0; }
.mg-stage canvas { display: block; width: 100%; height: 100%; cursor: grab; }
.mg-stage canvas:active { cursor: grabbing; }
.mg-loading {
  position: absolute; inset: 0; display: grid; place-items: center;
  color: #6ad8ea; font-size: 12px; letter-spacing: 2px; pointer-events: none;
  background: rgba(5, 7, 15, .4);
}
.mg-loading::before {
  content: ""; position: absolute; width: 46px; height: 46px; margin-top: -64px;
  border: 1px solid rgba(0, 229, 255, .25);
  border-top-color: var(--neon);
  border-radius: 50%;
  animation: mg-spin 1s linear infinite;
  box-shadow: 0 0 18px rgba(0, 229, 255, .3);
}
@keyframes mg-spin { to { transform: rotate(360deg); } }

/* 详情面板：深空玻璃 + 霓虹描边 */
.mg-detail {
  position: absolute; top: 0; right: 0; bottom: 0; width: min(430px, 94vw);
  background: linear-gradient(160deg, rgba(14, 22, 40, .94), rgba(7, 11, 22, .97));
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  color: #dbe8ff;
  border-left: 1px solid rgba(0, 229, 255, .28);
  box-shadow: -18px 0 60px rgba(0, 0, 0, .55), -1px 0 24px rgba(0, 229, 255, .12);
  display: flex; flex-direction: column;
  z-index: 5;
  animation: mg-slide .28s cubic-bezier(.2, .8, .2, 1);
}
@keyframes mg-slide { from { transform: translateX(24px); opacity: 0; } to { transform: none; opacity: 1; } }
.mg-detail[hidden] { display: none; }
.mg-detail-close {
  position: absolute; top: 12px; right: 14px; z-index: 2;
  width: 30px; height: 30px; border: 1px solid rgba(255,255,255,.14);
  border-radius: 8px; background: rgba(255,255,255,.05); color: #9fb6d6;
  font-size: 19px; line-height: 1; cursor: pointer;
  transition: all .18s ease;
}
.mg-detail-close:hover { color: #fff; border-color: rgba(255,45,111,.6); background: rgba(255,45,111,.16); }

.mg-detail-cat {
  display: inline-flex; align-items: center; align-self: flex-start;
  margin: 22px 20px 8px; padding: 4px 11px;
  border-radius: 4px; color: #06121c; font-size: 10.5px; font-weight: 800;
  letter-spacing: 1.5px; text-transform: uppercase;
  box-shadow: 0 0 16px currentColor;
}
.mg-detail h2 {
  margin: 0 20px 6px; font-size: 21px; line-height: 1.4; font-weight: 600;
  letter-spacing: .3px; color: #f2f8ff;
}
.mg-detail h2::after {
  content: ""; display: block; width: 34px; height: 2px; margin-top: 10px;
  background: linear-gradient(90deg, var(--neon), transparent);
}
.mg-detail-meta {
  margin: 0 20px 16px; font-size: 10.5px; letter-spacing: .5px; color: #6a83a8;
}
.mg-detail-body {
  flex: 1; overflow-y: auto; padding: 2px 20px 20px;
  font-size: 13px; line-height: 1.8;
  scrollbar-width: thin; scrollbar-color: rgba(0,229,255,.3) transparent;
}
.mg-detail-body::-webkit-scrollbar { width: 5px; }
.mg-detail-body::-webkit-scrollbar-thumb { background: rgba(0,229,255,.28); border-radius: 5px; }
.mg-detail-body h1, .mg-detail-body h2, .mg-detail-body h3 {
  line-height: 1.4; margin: 18px 0 8px; color: #eaf4ff; font-weight: 600;
}
.mg-detail-body h1 { font-size: 17px; }
.mg-detail-body h2 { font-size: 15px; }
.mg-detail-body h3 { font-size: 13.5px; }
.mg-detail-body a { color: #7ff3ff; text-decoration: none; border-bottom: 1px dotted rgba(127,243,255,.4); }
.mg-detail-body blockquote {
  margin: 12px 0; padding: 8px 12px; border-left: 2px solid var(--neon);
  background: rgba(0, 229, 255, .05); color: #a9c4de;
}
.mg-detail-body pre {
  background: rgba(0, 0, 0, .35); padding: 11px 13px; border-radius: 8px;
  border: 1px solid rgba(0,229,255,.12);
  overflow-x: auto; font-size: 11.5px; color: #9fe8f5;
}
.mg-detail-body code {
  font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
  background: rgba(0,229,255,.09); padding: 1px 5px; border-radius: 4px; color: #9fe8f5;
}
.mg-detail-body img { max-width: 100%; border-radius: 6px; }
.mg-detail-body hr { border: none; border-top: 1px solid rgba(0,229,255,.16); margin: 18px 0; }

/* 文件管理：极简线条 */
.mg-files {
  border-top: 1px solid rgba(0, 229, 255, .16);
  padding: 14px 20px 18px; flex: none; max-height: 42%; overflow-y: auto;
  background: rgba(0, 0, 0, .18);
}
.mg-files-head { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; margin-bottom: 10px; }
.mg-files-head strong { font-size: 12px; font-weight: 600; letter-spacing: 1px; color: #cfe6ff; }
.mg-files-head strong::before { content: "▸ "; color: var(--neon); }
.mg-files-tip { font-size: 10px; letter-spacing: .3px; color: #5f7596; }
.mg-upload {
  display: inline-flex; align-items: center; justify-content: center;
  padding: 7px 15px; border: 1px dashed rgba(0, 229, 255, .4); border-radius: 7px;
  color: #7ff3ff; font-size: 11.5px; letter-spacing: .5px; cursor: pointer; margin-bottom: 10px;
  transition: all .18s ease;
}
.mg-upload:hover { background: rgba(0, 229, 255, .1); border-color: var(--neon); box-shadow: 0 0 14px rgba(0,229,255,.2); }
.mg-file-list { display: flex; flex-direction: column; gap: 6px; }
.mg-file-item {
  display: flex; align-items: center; gap: 8px; padding: 7px 9px; border-radius: 7px;
  background: rgba(255,255,255,.035); border: 1px solid rgba(255,255,255,.06);
}
.mg-file-name { flex: 1; min-width: 0; font-size: 11.5px; color: #c8dcf5; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.mg-file-size { font-size: 10px; letter-spacing: .3px; color: #6a83a8; }
.mg-file-btn {
  border: 1px solid rgba(255,255,255,.1); background: rgba(255,255,255,.04); color: #9fb6d6;
  width: 23px; height: 23px; border-radius: 5px; cursor: pointer; font-size: 12px;
  transition: all .16s ease;
}
.mg-file-btn:hover { color: #fff; border-color: rgba(0,229,255,.5); background: rgba(0,229,255,.14); }
.mg-file-rm:hover { border-color: rgba(255,45,111,.6); background: rgba(255,45,111,.18); }
.mg-empty { font-size: 11px; letter-spacing: .4px; color: #5f7596; margin: 4px 0; }

@media (max-width: 640px) {
  .mg-view { height: calc(100dvh - 120px); min-height: 380px; }
  .mg-toolbar { padding: 9px 12px; }
  .mg-hint { display: none; }
  .mg-detail { width: 100%; top: auto; height: 74%; border-left: none; border-top: 1px solid rgba(0,229,255,.3); }
  .mg-toolbar .pmv-btn { font-size: 11px; padding: 6px 9px; }
}
